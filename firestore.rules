rules_version = '2';
// Chess + UNO Arena — Fase 4.
// A profile document is private to its owner: nobody can read or write
// another player's nickname/stats. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 16;
      // every update must keep a valid nickname on the resulting document
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 16;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
