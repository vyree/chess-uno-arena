# Contoh environment variables. Salin ke .env bila perlu (tidak wajib).
# Proyek ini tidak memakai secret/API key apa pun di server.
PORT=3000
# Fase 4: isi dengan Firebase project id untuk MENGAKTIFKAN gerbang login
# Google (verifikasi ID token). Kosong = mode dev terbuka (hanya lokal).
FIREBASE_PROJECT_ID=
