# Contoh environment variables. Salin ke .env bila perlu (tidak wajib).
# Proyek ini tidak memakai secret/API key apa pun di server.
PORT=3000
# Login Google DIPARKIR (2026-10-21). Untuk menghidupkannya lagi nanti:
# isi FIREBASE_PROJECT_ID dan set REQUIRE_AUTH=1. Selama itu kosong,
# server berjalan mode nickname terbuka.
FIREBASE_PROJECT_ID=
REQUIRE_AUTH=
